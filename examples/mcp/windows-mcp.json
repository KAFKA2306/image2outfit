{
  "mcpServers": {
    "blender": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--python",
        "3.11",
        "blender-mcp==1.8.0"
      ],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "unityMCP": {
      "transport": "loopback-tcp-discovery-registry",
      "registry": "%LOCALAPPDATA%/UnityMCP/registry"
    }
  }
}

{
  "schemaVersion": 1,
  "profileId": "garment-reconstruction-v1",
  "researchPrinciples": [
    "pattern-first-structured-garment",
    "geometry-first-stitch-graph",
    "pose-normalized-pattern-recovery",
    "pattern-coordinate-mapping"
  ],
  "stages": [
    {"stage":"ingest-reference","toolName":"reference-ingest","purpose":"Bind the source image, hashes, provenance, and target avatar.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"normalize-view","toolName":"pose-view-normalizer","purpose":"Separate pose and viewpoint effects from garment evidence.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"decompose-garment","toolName":"semantic-part-decomposer","purpose":"Name garment parts by construction role and body region.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"draft-patterns","toolName":"pattern-piece-drafter","purpose":"Create explicit two-dimensional panel boundaries and correspondence identifiers.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"infer-stitches","toolName":"stitch-graph-builder","purpose":"Create explicit edge-to-edge and multi-edge sewing topology.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"initialize-3d","toolName":"pattern-initializer","purpose":"Place pattern pieces around the avatar without folds or intersections.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"build-blender","toolName":"blender-python-runner","purpose":"Invoke the declared Blender Python build script through one reusable adapter.","requiredInExecute":true,"minimumEvidenceCount":2,"requiredResultFields":{}},
    {"stage":"simulate-cloth","toolName":"blender-cloth-simulator","purpose":"Apply the declared cloth, collision, and cache contract.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"skin-and-export","toolName":"skinning-fbx-exporter","purpose":"Bind semantic body regions to bones and export the editable source and FBX.","requiredInExecute":true,"minimumEvidenceCount":2,"requiredResultFields":{}},
    {"stage":"render-evidence","toolName":"evidence-renderer","purpose":"Render required five views and declared poses from the current artifact.","requiredInExecute":true,"minimumEvidenceCount":5,"requiredResultFields":{}},
    {"stage":"audit-geometry","toolName":"geometry-fit-auditor","purpose":"Measure topology, weights, degeneracy, collisions, and evidence hashes.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{}},
    {"stage":"visual-review","toolName":"visual-appearance-gate","purpose":"Require direct inspection of current images before visualAppearanceReview can pass.","requiredInExecute":true,"minimumEvidenceCount":5,"requiredResultFields":{"reviewMethod":"direct-image-inspection"}},
    {"stage":"finalize-candidate","toolName":"candidate-finalizer","purpose":"Write the truthful WORKING, COMPLETE, or REJECTED candidate state.","requiredInExecute":true,"minimumEvidenceCount":1,"requiredResultFields":{"decisionRecorded":true}}
  ]
}

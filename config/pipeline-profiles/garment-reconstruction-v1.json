{
  "schemaVersion": 1,
  "profileId": "garment-reconstruction-v1",
  "auditContract": {
    "recordSchema": "config/pipeline/stage-audit-record.schema.v1.json",
    "manifestSchema": "config/pipeline/run-audit-manifest.schema.v1.json",
    "storageRoot": ".image2outfit/audit/{productId}/{runId}",
    "hashAlgorithm": "SHA-256",
    "chain": "previousRecordDigest"
  },
  "researchPrinciples": [
    "pattern-first-structured-garment",
    "geometry-first-stitch-graph",
    "pose-normalized-pattern-recovery",
    "pattern-coordinate-mapping",
    "external-generators-are-bounded-hypotheses"
  ],
  "stages": [
    {
      "stage": "ingest-reference",
      "toolName": "reference-ingest",
      "purpose": "Bind the source image, hashes, provenance, and target avatar.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "referenceManifest",
        "sourceSha256",
        "provenance",
        "targetAvatarBinding"
      ]
    },
    {
      "stage": "normalize-view",
      "toolName": "pose-view-normalizer",
      "purpose": "Separate pose and viewpoint effects from garment evidence and preserve observed/inferred/unknown boundaries.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "normalizationContractValidated": true,
        "observationSource": "original-image"
      },
      "managedOutputs": [
        "normalizedReference",
        "cameraPose",
        "bodyLandmarks",
        "normalizationMetrics",
        "initialBlueprint"
      ]
    },
    {
      "stage": "decompose-garment",
      "toolName": "semantic-part-decomposer",
      "purpose": "Name garment parts by construction role and body region while keeping generation method separate.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "garmentPartGraph",
        "spatialAssignments",
        "materialRegions",
        "ambiguityLog",
        "generationAssignments"
      ]
    },
    {
      "stage": "draft-patterns",
      "toolName": "pattern-piece-drafter",
      "purpose": "Create explicit two-dimensional panel boundaries and correspondence identifiers.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "patternSpecification",
        "patternEdges",
        "seamAllowances",
        "notchesAndDarts",
        "correspondenceMap"
      ]
    },
    {
      "stage": "infer-stitches",
      "toolName": "stitch-graph-builder",
      "purpose": "Create explicit edge-to-edge and multi-edge sewing topology.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "stitchGraph",
        "edgePairings",
        "stitchDirections",
        "topologyValidation"
      ]
    },
    {
      "stage": "initialize-3d",
      "toolName": "pattern-initializer",
      "purpose": "Place pattern pieces around the avatar and own any selected external draft only as a bounded hypothesis.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "initializedMesh",
        "panelTransforms",
        "initialClearanceAudit",
        "hypothesisSet",
        "selectedHypothesis",
        "targetAvatarAuthority"
      ]
    },
    {
      "stage": "build-blender",
      "toolName": "blender-python-runner",
      "purpose": "Invoke the declared Blender Python build script and own bounded reconciliation of a selected hypothesis.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 2,
      "requiredResultFields": {},
      "managedOutputs": [
        "editableBlend",
        "buildReport",
        "geometryMetrics",
        "reconciliationContract"
      ]
    },
    {
      "stage": "simulate-cloth",
      "toolName": "blender-cloth-simulator",
      "purpose": "Apply the declared cloth, collision, and cache contract.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "clothCache",
        "simulationConfig",
        "collisionReport",
        "simulatedMesh"
      ]
    },
    {
      "stage": "skin-and-export",
      "toolName": "skinning-fbx-exporter",
      "purpose": "Bind semantic body regions to bones and export the editable source and FBX.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 2,
      "requiredResultFields": {},
      "managedOutputs": [
        "skinnedBlend",
        "fbx",
        "weightAudit",
        "prefabDeclaration"
      ]
    },
    {
      "stage": "render-evidence",
      "toolName": "evidence-renderer",
      "purpose": "Render canonical review evidence while keeping optional AI re-input render-back separate from quality evidence.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 5,
      "requiredResultFields": {},
      "managedOutputs": [
        "fiveViewImages",
        "requiredPoseImages",
        "renderManifest",
        "qaRenderManifest",
        "renderBackManifest"
      ]
    },
    {
      "stage": "audit-geometry",
      "toolName": "geometry-fit-auditor",
      "purpose": "Measure topology, weights, degeneracy, collisions, evidence hashes, and blueprint-vs-actual deviations when declared.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "geometryAudit",
        "penetrationAudit",
        "evidenceHashAudit",
        "gateSummary",
        "blueprintActualAudit"
      ]
    },
    {
      "stage": "visual-review",
      "toolName": "visual-appearance-gate",
      "purpose": "Require direct inspection of current images and bind the planning blueprint without treating it as visual evidence.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 5,
      "requiredResultFields": {
        "reviewMethod": "direct-image-inspection"
      },
      "managedOutputs": [
        "visualReview",
        "inspectedImageHashes",
        "blockingFindings",
        "reviewBundle"
      ]
    },
    {
      "stage": "finalize-candidate",
      "toolName": "candidate-finalizer",
      "purpose": "Write the truthful WORKING, COMPLETE, or REJECTED candidate state.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "decisionRecorded": true
      },
      "managedOutputs": [
        "candidateState",
        "completionGateRecord",
        "releaseDecision"
      ]
    }
  ]
}

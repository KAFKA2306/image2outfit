{
  "schemaVersion": 1,
  "profileId": "garment-reconstruction-v1",
  "auditContract": {
    "recordSchema": "config/pipeline/stage-audit-record.schema.v1.json",
    "manifestSchema": "config/pipeline/run-audit-manifest.schema.v1.json",
    "storageRoot": ".image2outfit/audit/{productId}/{runId}",
    "hashAlgorithm": "SHA-256",
    "chain": "previousRecordDigest"
  },
  "researchPrinciples": [
    "pattern-first-structured-garment",
    "geometry-first-stitch-graph",
    "pose-normalized-pattern-recovery",
    "pattern-coordinate-mapping"
  ],
  "stages": [
    {
      "stage": "ingest-reference",
      "toolName": "reference-ingest",
      "purpose": "Bind the source image, hashes, provenance, and target avatar.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "referenceManifest",
        "sourceSha256",
        "provenance",
        "targetAvatarBinding"
      ]
    },
    {
      "stage": "normalize-view",
      "toolName": "pose-view-normalizer",
      "purpose": "Validate source-bound observations and reversible source-coordinate normalization without promoting generated views to observations.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "normalizedObservations",
        "sourceCoordinateTransforms",
        "observationEvidenceClass",
        "normalizationMetrics"
      ]
    },
    {
      "stage": "decompose-garment",
      "toolName": "semantic-part-decomposer",
      "purpose": "Name garment parts by construction role and body region.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "garmentPartGraph",
        "spatialAssignments",
        "materialRegions",
        "ambiguityLog"
      ]
    },
    {
      "stage": "draft-patterns",
      "toolName": "pattern-piece-drafter",
      "purpose": "Create explicit two-dimensional panel boundaries and correspondence identifiers.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "outputRole": "patternSpecification"
      },
      "managedOutputs": [
        "patternSpecification",
        "patternEdges",
        "seamAllowances",
        "correspondenceMap",
        "producerConsumerContract"
      ]
    },
    {
      "stage": "infer-stitches",
      "toolName": "stitch-graph-builder",
      "purpose": "Create explicit edge-to-edge and multi-edge sewing topology.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "outputRole": "stitchGraph"
      },
      "managedOutputs": [
        "stitchGraph",
        "edgePairings",
        "stitchDirections",
        "topologyValidation",
        "producerConsumerContract"
      ]
    },
    {
      "stage": "initialize-3d",
      "toolName": "pattern-initializer",
      "purpose": "Place pattern pieces around the avatar without folds or intersections.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "initializedPatternPiece": "lower-skirt-ring"
      },
      "managedOutputs": [
        "initializedMesh",
        "panelTransforms",
        "initialClearanceAudit"
      ]
    },
    {
      "stage": "build-blender",
      "toolName": "blender-python-runner",
      "purpose": "Invoke the declared Blender Python build script through one reusable adapter.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 2,
      "requiredResultFields": {
        "variantProofed": true
      },
      "managedOutputs": [
        "editableBlend",
        "buildReport",
        "geometryMetrics",
        "patternToMeshMapping",
        "variantPropagationProof",
        "geometryPreview",
        "materialRecipeBinding"
      ]
    },
    {
      "stage": "simulate-cloth",
      "toolName": "blender-cloth-simulator",
      "purpose": "Apply the declared cloth, collision, and cache contract.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "cacheValidatedBeforeApply": true,
        "reusableCacheAvailable": false
      },
      "managedOutputs": [
        "simulationConfig",
        "validatedPointCache",
        "evaluatedFrameMeshes",
        "inputHashBinding",
        "simulatedMesh"
      ]
    },
    {
      "stage": "skin-and-export",
      "toolName": "skinning-fbx-exporter",
      "purpose": "Bind semantic body regions to bones and export the editable source and FBX.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 2,
      "requiredResultFields": {},
      "managedOutputs": [
        "skinnedBlend",
        "fbx",
        "weightAudit",
        "prefabDeclaration"
      ]
    },
    {
      "stage": "render-evidence",
      "toolName": "evidence-renderer",
      "purpose": "Render required five views and declared poses from the current artifact.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 5,
      "requiredResultFields": {},
      "managedOutputs": [
        "fiveViewImages",
        "requiredPoseImages",
        "renderManifest"
      ]
    },
    {
      "stage": "audit-geometry",
      "toolName": "geometry-fit-auditor",
      "purpose": "Measure topology, weights, degeneracy, collisions, and evidence hashes.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {},
      "managedOutputs": [
        "geometryAudit",
        "penetrationAudit",
        "evidenceHashAudit",
        "gateSummary"
      ]
    },
    {
      "stage": "visual-review",
      "toolName": "visual-appearance-gate",
      "purpose": "Require direct inspection of current images before visualAppearanceReview can pass.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 5,
      "requiredResultFields": {
        "reviewMethod": "direct-image-inspection"
      },
      "managedOutputs": [
        "visualReview",
        "inspectedImageHashes",
        "blockingFindings"
      ]
    },
    {
      "stage": "finalize-candidate",
      "toolName": "candidate-finalizer",
      "purpose": "Write the truthful WORKING, COMPLETE, or REJECTED candidate state.",
      "requiredInExecute": true,
      "minimumEvidenceCount": 1,
      "requiredResultFields": {
        "decisionRecorded": true
      },
      "managedOutputs": [
        "candidateState",
        "completionGateRecord",
        "releaseDecision"
      ]
    }
  ]
}

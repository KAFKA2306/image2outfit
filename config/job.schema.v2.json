{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/job.schema.v2.json",
  "title": "image2outfit job v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "productName",
    "adapterId",
    "buildScript",
    "blendPath",
    "fbxAssetPath",
    "prefabAssetPath",
    "integratedPrefabAssetPath",
    "targetAvatarAssetPath",
    "artifactDir",
    "candidateDir",
    "releaseDir",
    "licenseEvidence",
    "privateSourceRoots",
    "deliveryAssets",
    "previewPaths",
    "humanEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "productName": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "productRoot": { "type": "string", "pattern": "^Assets/GenWorks/[a-z0-9][a-z0-9._-]*$" },
    "productManifestPath": { "type": "string", "pattern": "^Assets/GenWorks/[a-z0-9][a-z0-9._-]*/ProductManifest\\.json$" },
    "buildScript": { "type": "string" },
    "hostedPoseScript": { "type": "string" },
    "blendPath": { "type": "string" },
    "fbxAssetPath": { "type": "string", "pattern": "^Assets/" },
    "prefabAssetPath": { "type": "string", "pattern": "^Assets/" },
    "integratedPrefabAssetPath": { "type": "string", "pattern": "^Assets/" },
    "targetAvatarAssetPath": { "type": "string", "pattern": "^Assets/" },
    "targetSourcePath": { "type": "string", "pattern": "^Assets/" },
    "artifactDir": { "type": "string", "pattern": "^Artifacts/" },
    "candidateDir": { "type": "string", "pattern": "^Candidates/" },
    "releaseDir": { "type": "string", "pattern": "^Release/" },
    "licenseEvidence": { "type": "string" },
    "privateSourceRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^Assets/" } },
    "deliveryAssets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^Assets/" } },
    "previewPaths": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^Assets/" } },
    "humanEvidence": {
      "type": "object",
      "required": ["visual-review", "pose-penetration-review", "vrchat-runtime-review"],
      "additionalProperties": { "type": "string" }
    },
    "allowedExtraBones": { "type": "array", "items": { "type": "string" } }
  }
}

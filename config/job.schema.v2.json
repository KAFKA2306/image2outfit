{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/job.schema.v2.json",
  "title": "image2outfit job v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "productName",
    "adapterId",
    "productRoot",
    "productManifestPath",
    "buildScript",
    "blendPath",
    "fbxAssetPath",
    "prefabAssetPath",
    "integratedPrefabAssetPath",
    "targetAvatarAssetPath",
    "licenseEvidence",
    "privateSourceRoots",
    "deliveryAssets",
    "previewPaths",
    "humanEvidence"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "productName": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "automaticBuild": {"type": "boolean"},
    "buildCapability": {"type": "string", "minLength": 1},
    "buildRevision": {"type": "string", "minLength": 1},
    "renderLoopRevision": {"type": "string", "minLength": 1},
    "productRoot": {
      "type": "string",
      "pattern": "^Assets/GenWorks/[a-z0-9][a-z0-9._-]*$"
    },
    "productManifestPath": {
      "type": "string",
      "pattern": "^Assets/GenWorks/[a-z0-9][a-z0-9._-]*/ProductManifest\\.json$"
    },
    "buildScript": {"type": "string", "pattern": "^tools/[^/]+\\.py$"},
    "productBuildScript": {"type": "string", "pattern": "^tools/[^/]+\\.py$"},
    "hostedPoseScript": {"type": "string", "pattern": "^tools/[^/]+\\.py$"},
    "blendPath": {"type": "string", "pattern": "^Assets/GenWorks/"},
    "fbxAssetPath": {"type": "string", "pattern": "^Assets/GenWorks/"},
    "prefabAssetPath": {"type": "string", "pattern": "^Assets/GenWorks/"},
    "integratedPrefabAssetPath": {"type": "string", "pattern": "^Assets/GenWorks/"},
    "targetAvatarAssetPath": {"type": "string", "pattern": "^Assets/"},
    "targetSourcePath": {"type": "string", "pattern": "^Assets/"},
    "targetResolution": {"type": "object"},
    "bodyShapeProfile": {"type": "object"},
    "garmentPipeline": {"type": "object"},
    "researchMethod": {"type": "object"},
    "licenseEvidence": {"type": "string", "pattern": "^config/products/"},
    "privateSourceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^Assets/"}
    },
    "deliveryAssets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^Assets/"}
    },
    "patternLayoutPath": {
      "type": "string",
      "pattern": "^Assets/GenWorks/.+/Previews/pattern-layout\\.png$"
    },
    "previewPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "back", "left", "right", "three-quarter"],
      "properties": {
        "front": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/front\\.png$"},
        "back": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/back\\.png$"},
        "left": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/left\\.png$"},
        "right": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/right\\.png$"},
        "three-quarter": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/three-quarter\\.png$"}
      }
    },
    "posePaths": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^Assets/GenWorks/.+/Previews/Poses/.+\\.png$"}
    },
    "humanEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual-review", "pose-penetration-review", "vrchat-runtime-review"],
      "properties": {
        "visual-review": {"type": "string", "pattern": "^Assets/_Local/Evidence/"},
        "pose-penetration-review": {"type": "string", "pattern": "^Assets/_Local/Evidence/"},
        "vrchat-runtime-review": {"type": "string", "pattern": "^Assets/_Local/Evidence/"}
      }
    },
    "allowedExtraBones": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}

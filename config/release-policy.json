{
  "schemaVersion": 1,
  "blockedReleaseAdapterIds": [
    "haolan-v1.6"
  ],
  "minimumPreview": {
    "width": 1024,
    "height": 1024,
    "requiredViews": [
      "front",
      "back",
      "left",
      "right",
      "three-quarter"
    ]
  },
  "minimumVisualScore": 4,
  "requiredPoses": [
    "neutral",
    "arms-up",
    "arm-cross",
    "crouch",
    "sit",
    "prone"
  ],
  "requiredHumanEvidenceKinds": [
    "visual-review",
    "pose-penetration-review",
    "vrchat-runtime-review"
  ],
  "humanEvidenceContracts": {
    "schemaVersion": 2,
    "passStatus": "PASS",
    "commonRequiredFields": [
      "schemaVersion",
      "kind",
      "jobId",
      "adapterId",
      "candidateManifestSha256",
      "status",
      "checkedAt",
      "reviewer",
      "defects"
    ],
    "common": {
      "reviewerPrefix": "human:",
      "forbiddenReviewers": [
        "human:<name>",
        "human:unknown",
        "human:automation",
        "human:bot"
      ],
      "allowedDefectSeverities": [
        "blocker",
        "critical",
        "major",
        "minor"
      ],
      "blockingDefectSeverities": [
        "blocker",
        "critical",
        "major"
      ],
      "allowedDefectStatuses": [
        "OPEN",
        "CONFIRMED",
        "RESOLVED",
        "NOT_REPRODUCIBLE",
        "ACCEPTED"
      ],
      "closedDefectStatuses": [
        "RESOLVED",
        "NOT_REPRODUCIBLE"
      ],
      "acceptedDefectStatus": "ACCEPTED"
    },
    "visual-review": {
      "requiredFields": [
        "scores",
        "criticalDefects",
        "defects",
        "reviewedAssets",
        "reviewSummary",
        "customerUseCase"
      ],
      "scoreFields": [
        "referenceFidelity",
        "silhouette",
        "fitCoverage",
        "deformation",
        "material",
        "presentation",
        "customerUsability"
      ],
      "minimumScore": 4,
      "minimumAverageScore": 4.5,
      "maximumCriticalDefects": 0,
      "requiredPreviewAssets": [
        "Preview/front.png",
        "Preview/back.png",
        "Preview/left.png",
        "Preview/right.png",
        "Preview/three-quarter.png"
      ],
      "requiredTextFields": [
        "reviewSummary",
        "customerUseCase"
      ]
    },
    "pose-penetration-review": {
      "requiredFields": [
        "poses",
        "poseEvidence",
        "criticalPenetrations",
        "defects",
        "reviewedAssets",
        "poseNotes"
      ],
      "requiredPoses": [
        "neutral",
        "arms-up",
        "arm-cross",
        "crouch",
        "sit",
        "prone"
      ],
      "passValue": "PASS",
      "maximumCriticalPenetrations": 0
    },
    "vrchat-runtime-review": {
      "requiredFields": [
        "vrchatBuildAndTest",
        "testedInVRChat",
        "runtimeScreenshot",
        "runtimeScreenshotSha256",
        "runtimeNotes",
        "testedPlatform",
        "installationStepsVerified",
        "customerReady",
        "customerAcceptance",
        "defects"
      ],
      "passValue": "PASS",
      "testedInVRChat": true,
      "minimumScreenshotWidth": 1280,
      "minimumScreenshotHeight": 720,
      "customerAcceptanceFields": [
        "appearance",
        "fitDuringMotion",
        "installation",
        "menuOperation",
        "runtimeStability"
      ]
    }
  },
  "allowedDeliveryExtensions": [
    ".blend",
    ".fbx",
    ".prefab",
    ".mat",
    ".meta",
    ".png",
    ".jpg",
    ".jpeg",
    ".tga",
    ".psd",
    ".webp",
    ".unity",
    ".asset",
    ".controller",
    ".anim",
    ".shader",
    ".asmdef",
    ".txt",
    ".md",
    ".json"
  ]
}

{
  "schemaVersion": 1,
  "singleReleaseValidator": "tools/customer_quality.py",
  "blockedReleaseAdapterIds": [
    "haolan-v1.6"
  ],
  "minimumPreview": {
    "width": 1024,
    "height": 1024,
    "requiredViews": [
      "front",
      "back",
      "left",
      "right",
      "three-quarter"
    ]
  },
  "minimumVisualScore": 4,
  "requiredPoses": [
    "neutral",
    "arms-up",
    "arm-cross",
    "crouch",
    "sit",
    "prone"
  ],
  "requiredHumanEvidenceKinds": [
    "visual-review",
    "pose-penetration-review",
    "vrchat-runtime-review"
  ],
  "humanEvidenceContracts": {
    "schemaVersion": 2,
    "passStatus": "PASS",
    "commonRequiredFields": [
      "schemaVersion",
      "kind",
      "jobId",
      "adapterId",
      "candidateManifestSha256",
      "status",
      "checkedAt",
      "reviewer",
      "reviewerReference",
      "defects"
    ],
    "common": {
      "reviewerPrefix": "human:",
      "reviewerReferenceHosts": [
        "github.com"
      ],
      "forbiddenReviewers": [
        "human:<name>",
        "human:unknown",
        "human:automation",
        "human:bot"
      ],
      "allowedDefectSeverities": [
        "blocker",
        "critical",
        "major",
        "minor"
      ],
      "blockingDefectSeverities": [
        "blocker",
        "critical",
        "major"
      ],
      "allowedDefectStatuses": [
        "OPEN",
        "CONFIRMED",
        "RESOLVED",
        "NOT_REPRODUCIBLE",
        "ACCEPTED"
      ],
      "closedDefectStatuses": [
        "RESOLVED",
        "NOT_REPRODUCIBLE"
      ],
      "acceptedDefectStatus": "ACCEPTED"
    },
    "visual-review": {
      "requiredFields": [
        "scores",
        "criticalDefects",
        "defects",
        "reviewedAssets",
        "reviewSummary",
        "customerUseCase"
      ],
      "scoreFields": [
        "referenceFidelity",
        "silhouette",
        "fitCoverage",
        "deformation",
        "material",
        "presentation",
        "customerUsability"
      ],
      "minimumScore": 4,
      "minimumAverageScore": 4.5,
      "maximumCriticalDefects": 0,
      "requiredPreviewAssets": [
        "Preview/front.png",
        "Preview/back.png",
        "Preview/left.png",
        "Preview/right.png",
        "Preview/three-quarter.png"
      ],
      "requiredTextFields": [
        "reviewSummary",
        "customerUseCase"
      ]
    },
    "pose-penetration-review": {
      "requiredFields": [
        "poses",
        "poseEvidence",
        "criticalPenetrations",
        "defects",
        "reviewedAssets",
        "poseNotes"
      ],
      "passValue": "PASS",
      "maximumCriticalPenetrations": 0
    },
    "vrchat-runtime-review": {
      "requiredFields": [
        "vrchatBuildAndTest",
        "testedInVRChat",
        "runtimeScreenshot",
        "runtimeScreenshotSha256",
        "runtimeNotes",
        "testedPlatform",
        "installationStepsVerified",
        "customerReady",
        "customerAcceptance",
        "defects"
      ],
      "passValue": "PASS",
      "testedInVRChat": true,
      "minimumScreenshotWidth": 1280,
      "minimumScreenshotHeight": 720,
      "customerAcceptanceFields": [
        "appearance",
        "fitDuringMotion",
        "installation",
        "menuOperation",
        "runtimeStability"
      ]
    }
  },
  "commercialMethodPolicy": {
    "profileId": "commercial-v2",
    "profiles": {
      "fitted": {
        "description": "Body-conforming garment whose primary deformation is inherited from the avatar rig.",
        "requiredCapabilities": [
          "topology-uv",
          "pbr-texture",
          "dynamic-evaluation"
        ],
        "requiredEvidence": [
          "topology-audit",
          "pbr-audit",
          "motion-review"
        ]
      },
      "panel-sewn": {
        "description": "Garment assembled from editable pattern panels and explicit seam connectivity.",
        "requiredCapabilities": [
          "structured-patterns",
          "stitch-assembly",
          "topology-uv",
          "pbr-texture",
          "dynamic-evaluation"
        ],
        "requiredEvidence": [
          "panel-graph",
          "seam-graph",
          "connectivity-audit",
          "topology-audit",
          "pbr-audit",
          "motion-review"
        ]
      },
      "loose-layered": {
        "description": "Loose or layered garment that requires explicit layer, collision, and runtime deformation evaluation.",
        "requiredCapabilities": [
          "structured-patterns",
          "stitch-assembly",
          "topology-uv",
          "layering-collision",
          "pbr-texture",
          "runtime-deformation",
          "dynamic-evaluation"
        ],
        "requiredEvidence": [
          "panel-graph",
          "seam-graph",
          "connectivity-audit",
          "layer-map",
          "penetration-report",
          "topology-audit",
          "pbr-audit",
          "deformation-benchmark",
          "runtime-performance",
          "motion-review"
        ]
      }
    },
    "evidenceContract": {
      "schemaVersion": 2,
      "passStatus": "PASS",
      "requiredFields": [
        "schemaVersion",
        "kind",
        "productId",
        "constructionProfile",
        "candidateManifestSha256",
        "status",
        "checkedAt",
        "tool",
        "sourceArtifacts",
        "metrics",
        "notes"
      ],
      "toolContract": {
        "requiredFields": [
          "id",
          "version",
          "command"
        ]
      },
      "sourceArtifactContract": {
        "requiredFields": [
          "path",
          "sha256"
        ],
        "candidateHashBindingRequired": true
      },
      "evidenceRootTemplate": "Assets/GenWorks/{productId}/Evidence/Commercial",
      "metricRules": {
        "panel-graph": {
          "minimum": {"panelCount": 1},
          "maximum": {"unmappedPanels": 0}
        },
        "seam-graph": {
          "minimum": {"seamPairCount": 1},
          "maximum": {"unmatchedEdges": 0, "ambiguousEdges": 0, "reversedEdges": 0}
        },
        "connectivity-audit": {
          "requiredTrue": ["edgeLengthCompatibilityPassed", "orientationPassed", "assemblyPassed"]
        },
        "layer-map": {
          "minimum": {"declaredLayerCount": 1},
          "maximum": {"undeclaredComponents": 0}
        },
        "penetration-report": {
          "maximum": {"blockerPenetrations": 0, "criticalPenetrations": 0, "maxPenetrationDepthMm": 3.0}
        },
        "topology-audit": {
          "maximum": {"nonFiniteVertices": 0, "degenerateTriangles": 0, "maxBoneInfluences": 4},
          "requiredTrue": ["uvContinuityPassed", "materialAssignmentsPassed"]
        },
        "pbr-audit": {
          "maximum": {"visibleSeamDefects": 0, "unreviewedOccludedRegions": 0, "crossViewColorDeltaE95": 5.0},
          "requiredTrue": ["albedoPassed", "normalPassed", "roughnessPassed"]
        },
        "deformation-benchmark": {
          "maximum": {"blockingPoseFailures": 0, "temporalArtifacts": 0},
          "requiredTrue": ["requiredPosesPassed", "selectedMethodMeasuredOnTarget"]
        },
        "runtime-performance": {
          "minimum": {"fpsP05": 45.0},
          "maximum": {"frameTimeP95Ms": 22.3},
          "requiredTrue": ["targetDeviceMeasured"]
        },
        "motion-review": {
          "minimum": {"sequencesReviewed": 3},
          "maximum": {"blockingTemporalDefects": 0},
          "requiredTrue": ["identityRetentionPassed", "detailRetentionPassed", "collisionReviewPassed"]
        }
      }
    }
  },
  "allowedDeliveryExtensions": [
    ".blend",
    ".fbx",
    ".prefab",
    ".mat",
    ".meta",
    ".png",
    ".jpg",
    ".jpeg",
    ".tga",
    ".psd",
    ".webp",
    ".unity",
    ".asset",
    ".controller",
    ".anim",
    ".shader",
    ".asmdef",
    ".txt",
    ".md",
    ".json"
  ]
}

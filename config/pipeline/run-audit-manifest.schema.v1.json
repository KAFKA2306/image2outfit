{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/pipeline/run-audit-manifest.schema.v1.json",
  "title": "image2outfit pipeline run audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "productId",
    "profileId",
    "executionMode",
    "finalStatus",
    "createdAt",
    "canonicalStages",
    "recordedStageCount",
    "chainHeadDigest",
    "pipelineState",
    "stages"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "productId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "executionMode": {"enum": ["plan", "execute"]},
    "finalStatus": {"enum": ["PLANNED", "EXECUTED", "FAILED"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "canonicalStages": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recordedStageCount": {"type": "integer", "minimum": 1, "maximum": 13},
    "chainHeadDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pipelineState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "stage", "status", "path", "sha256", "recordDigest"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 13},
          "stage": {"type": "string", "minLength": 1},
          "status": {"enum": ["PLANNED", "PASS", "FAILED"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "recordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-request.schema.v1.json",
  "title": "Canonical Garment Pipeline Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "targetAvatar",
    "sourceReference"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "targetAvatar": {
      "type": "string",
      "minLength": 1
    },
    "sourceReference": {
      "type": "string",
      "minLength": 1
    },
    "revisionId": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "profilePath": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "object"
    },
    "stageBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "resultPath"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resultPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolRequirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolPins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-state.schema.v1.json",
  "title": "image2outfit persisted PipelineState v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "parent_run_id",
    "product_id",
    "target_avatar",
    "source_reference",
    "profile_id",
    "revision_id",
    "execution_mode",
    "status",
    "current_stage",
    "completed_stages",
    "events",
    "errors",
    "outputs",
    "stage_records",
    "resume_count",
    "resume_history"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": "string"},
    "product_id": {"type": "string", "minLength": 1},
    "target_avatar": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string"},
    "execution_mode": {"type": "string", "pattern": "^(plan|execute)$"},
    "status": {"type": "string", "pattern": "^(READY|PLANNING|PLANNED|RUNNING|EXECUTED|FAILED)$"},
    "current_stage": {"type": "string"},
    "completed_stages": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "events": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "object"},
    "stage_records": {"type": "array", "items": {"type": "object"}},
    "resume_count": {"type": "integer"},
    "resume_history": {"type": "array", "items": {"type": "object"}},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "checkpoint_reset": {"type": "object"},
    "toolPlan": {"type": "array", "items": {"type": "object"}},
    "audit": {"type": "object"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/pipeline-failure.schema.json",
  "title": "Canonical pipeline failure descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["errorCode", "phase", "message"],
  "properties": {
    "errorCode": {
      "type": "string",
      "enum": [
        "INVALID_PIPELINE_INPUT",
        "PIPELINE_CONFIGURATION_INVALID",
        "PIPELINE_EXECUTION_FAILED",
        "INVALID_RESUME_STATE",
        "PIPELINE_ENGINE_UNAVAILABLE",
        "AUDIT_PUBLICATION_FAILED",
        "INTERNAL_PIPELINE_ERROR"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["request", "contract", "profile", "resume", "registry", "pipeline", "audit"]
    },
    "message": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "causeCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  }
}

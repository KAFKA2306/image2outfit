{
  "schemaVersion": 1,
  "canonicalWorkspacePattern": "Assets/GenWorks/<product-id>",
  "statuses": [
    "WORKING",
    "TECHNICAL_READY",
    "HUMAN_REVIEW_PENDING",
    "RELEASED",
    "REJECTED"
  ],
  "requiredCheckpointJobFields": [
    "productManifestPath",
    "blendPath",
    "fbxAssetPath",
    "prefabAssetPath",
    "integratedPrefabAssetPath",
    "previewPaths",
    "deliveryAssets"
  ],
  "requiredPreviewViews": [
    "front",
    "back",
    "left",
    "right",
    "three-quarter"
  ],
  "requiredMergeCheckpointGates": [
    "blender",
    "fbx",
    "prefabDeclared",
    "fiveViewEvidence",
    "poseEvidence",
    "researchTrial"
  ],
  "repositoryCompletionBoundary": {
    "includedStages": [
      "Blender generation and final save",
      "primary-shell topology and opening audit",
      "five-view rendered visual review",
      "six-pose rendered fit and intersection audit",
      "FBX generation and declared Prefab asset presence"
    ],
    "externalOutOfScopeStages": [
      "Unity import/save/reload",
      "Modular Avatar/NDMF validation",
      "VRChat Build & Test",
      "VRChat runtime human review"
    ]
  },
  "requiredAutomatedTechnicalGatesBeforeHumanReview": [
    "blender",
    "fbx",
    "unityImport",
    "prefabSerialized",
    "prefabReload",
    "modularAvatar"
  ],
  "requiredHumanReleaseGates": [
    "humanVisualReview",
    "humanPoseReview",
    "humanRuntimeReview"
  ],
  "rules": {
    "actionsArtifactsAreCanonicalWorkState": false,
    "trackedCheckpointRequiredForHandoff": true,
    "unityRequiredForRepositoryMerge": false,
    "unityConfiguredPrefabsRequiredForTechnicalReady": true,
    "unityRequiredForRelease": true,
    "mergeWithoutUnityMustRemainWorking": true,
    "humanReviewRequiredForRelease": true,
    "rebuildFromZeroWhenCheckpointExists": false,
    "retainRejectedCheckpointAndReason": true,
    "externalRuntimeStagesAreRepositoryScope": false,
    "externalRuntimeStagesBlockRepositoryCompletion": false,
    "externalRuntimeStagesBlockBranchCleanup": false,
    "repositoryCompletionIsIndependentOfExternalReleaseStatus": true
  },
  "canonicalPrefabPattern": "Assets/GenWorks/<product-id>/Prefab/*.prefab"
}

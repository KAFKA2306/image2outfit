{
  "schemaVersion": 3,
  "canonicalWorkspacePattern": "Assets/GenWorks/<product-id>",
  "statuses": [
    "WORKING",
    "COMPLETE",
    "REJECTED"
  ],
  "completionStatus": "COMPLETE",
  "requiredCheckpointJobFields": [
    "productManifestPath",
    "blendPath",
    "fbxAssetPath",
    "prefabAssetPath",
    "integratedPrefabAssetPath",
    "previewPaths",
    "deliveryAssets"
  ],
  "requiredPreviewViews": [
    "front",
    "back",
    "left",
    "right",
    "three-quarter"
  ],
  "requiredCompletionGates": [
    "blender",
    "editableSource",
    "fbx",
    "prefabDeclared",
    "fiveViewEvidence",
    "poseEvidence",
    "runnerMachineAudit"
  ],
  "runnerMachineAudit": {
    "required": true,
    "profile": "contracts/quality/runner-only-machine-audit-v1.json",
    "requestSchema": "config/pipeline/runner-request-manifest.schema.v1.json",
    "states": [
      "PASS",
      "FAIL",
      "UNVERIFIED"
    ],
    "completionState": "PASS",
    "missingProducerState": "UNVERIFIED",
    "missingEvidenceState": "UNVERIFIED",
    "hashMismatchState": "UNVERIFIED",
    "unmeasurableState": "UNVERIFIED",
    "requiredEvidenceRatio": 1.0,
    "humanApprovalRequired": false,
    "candidateAdoption": "PARETO_DOMINANCE",
    "equalCandidateDecision": "REVERT",
    "stopReasons": [
      "SUCCESS",
      "STALLED",
      "BUDGET_EXHAUSTED",
      "FAILED_HARD"
    ]
  },
  "outOfScopeGates": [
    "unityImport",
    "unitySaveReload",
    "prefabReload",
    "modularAvatar",
    "ndmf",
    "vrchatBuildTest",
    "vrchatRuntime",
    "humanRuntimeReview",
    "visualAppearanceReview"
  ],
  "rules": {
    "actionsArtifactsAreCanonicalWorkState": false,
    "trackedCheckpointRequiredForHandoff": true,
    "completionDeterminedByRenderedEvidence": true,
    "runnerMachineAuditRequired": true,
    "visualAppearanceReviewRequiredForCompletion": false,
    "visualAppearanceReviewMayBePerformedByChatGPT": true,
    "unityRequiredForCompletion": false,
    "runtimeValidationInScope": false,
    "outOfScopeFailuresAreBlockers": false,
    "fitAuditFailureBlocksCompletion": true,
    "runtimeCompatibilityMustNotBeClaimedWithoutExternalEvidence": true,
    "rebuildFromZeroWhenCheckpointExists": false,
    "retainRejectedCheckpointAndReason": true,
    "missingProducerMayPass": false,
    "unverifiedMayPass": false,
    "thresholdMutationDuringRunAllowed": false,
    "humanDecisionWaitStateAllowed": false
  },
  "canonicalPrefabPattern": "Assets/GenWorks/<product-id>/Prefab/*.prefab"
}

{
  "schemaVersion": 2,
  "canonicalWorkspacePattern": "Assets/GenWorks/<product-id>",
  "statuses": [
    "WORKING",
    "COMPLETE",
    "REJECTED"
  ],
  "completionStatus": "COMPLETE",
  "requiredCheckpointJobFields": [
    "productManifestPath",
    "blendPath",
    "fbxAssetPath",
    "prefabAssetPath",
    "integratedPrefabAssetPath",
    "previewPaths",
    "deliveryAssets"
  ],
  "requiredPreviewViews": [
    "front",
    "back",
    "left",
    "right",
    "three-quarter"
  ],
  "requiredCompletionGates": [
    "blender",
    "editableSource",
    "fbx",
    "prefabDeclared",
    "fiveViewEvidence",
    "poseEvidence",
    "visualAppearanceReview"
  ],
  "outOfScopeGates": [
    "unityImport",
    "unitySaveReload",
    "prefabReload",
    "modularAvatar",
    "ndmf",
    "vrchatBuildTest",
    "vrchatRuntime",
    "humanRuntimeReview"
  ],
  "rules": {
    "actionsArtifactsAreCanonicalWorkState": false,
    "trackedCheckpointRequiredForHandoff": true,
    "completionDeterminedByRenderedEvidence": true,
    "visualAppearanceReviewRequired": true,
    "visualAppearanceReviewMayBePerformedByChatGPT": true,
    "unityRequiredForCompletion": false,
    "runtimeValidationInScope": false,
    "outOfScopeFailuresAreBlockers": false,
    "fitAuditFailureBlocksCompletion": false,
    "runtimeCompatibilityMustNotBeClaimedWithoutExternalEvidence": true,
    "rebuildFromZeroWhenCheckpointExists": false,
    "retainRejectedCheckpointAndReason": true
  },
  "canonicalPrefabPattern": "Assets/GenWorks/<product-id>/Prefab/*.prefab",
  "canonicalGateStates": [
    "PASS",
    "FAIL",
    "PENDING",
    "UNVERIFIED",
    "OUT_OF_SCOPE"
  ],
  "gateStateNormalization": {
    "PASS": "PASS",
    "FAIL": "FAIL",
    "PENDING": "PENDING",
    "UNVERIFIED": "UNVERIFIED",
    "OUT_OF_SCOPE": "OUT_OF_SCOPE",
    "DRY_RUN_PASS": "UNVERIFIED",
    "FAIL_EXACT_ORIGINAL_MISSING": "FAIL",
    "MISSING": "UNVERIFIED",
    "NON_BLOCKING_FAIL": "FAIL",
    "NON_BLOCKING_PENDING": "PENDING",
    "NOT_REQUIRED": "OUT_OF_SCOPE",
    "NOT_RUN": "UNVERIFIED",
    "PENDING_RETRY": "PENDING",
    "PRESERVED_UNVERIFIED": "UNVERIFIED",
    "REPLACEMENT_GENERATED": "UNVERIFIED",
    "REVIEW_REQUIRED": "PENDING",
    "WORKING": "UNVERIFIED"
  }
}

{
  "schemaVersion": 1,
  "mergeGate": {
    "workflowFile": "pr-merge-gate.yml",
    "workflowName": "PR merge gate"
  },
  "productReleaseGate": {
    "workflowFile": "release-self-hosted.yml",
    "validatorCommand": "tools/production_gate.py --mode release"
  },
  "allowedTrackedProductStatesAtMerge": [
    "WORKING",
    "COMPLETE",
    "REJECTED"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/products/surface-attachment-graph.schema.v1.json",
  "title": "image2outfit planned surface attachment graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "units",
    "layoutStatus",
    "evaluationBoundary",
    "overlays"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "units": { "enum": ["meter", "millimeter"] },
    "layoutStatus": { "const": "PROVISIONAL_UNMEASURED_2D" },
    "evaluationBoundary": { "type": "string", "minLength": 1 },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "overlayId",
          "hostPieceId",
          "overlayPieceId",
          "mirrorGroupId",
          "side",
          "transform",
          "openingEdgeId",
          "attachmentEdgeIds",
          "attachmentHypothesis"
        ],
        "properties": {
          "overlayId": { "type": "string", "minLength": 1 },
          "hostPieceId": { "type": "string", "minLength": 1 },
          "overlayPieceId": { "type": "string", "minLength": 1 },
          "mirrorGroupId": { "type": "string", "minLength": 1 },
          "side": { "enum": ["left", "right"] },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anchorLocalM", "targetPointOnHostM", "rotationDegrees", "mirrorX"],
            "properties": {
              "anchorLocalM": { "$ref": "#/$defs/vector2" },
              "targetPointOnHostM": { "$ref": "#/$defs/vector2" },
              "rotationDegrees": { "type": "number" },
              "mirrorX": { "type": "boolean" }
            }
          },
          "openingEdgeId": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "attachmentEdgeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "attachmentHypothesis": { "const": "planned-topstitch" }
        }
      }
    }
  },
  "$defs": {
    "vector2": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "number" }
    }
  }
}

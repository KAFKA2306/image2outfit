{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/products/construction.schema.v1.json",
  "title": "image2outfit construction contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "profile"],
  "properties": {
    "schemaVersion": {"const": 1},
    "productId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profile": {"type": "string", "pattern": "^(fitted|panel-sewn|loose-layered)$"},
    "target": {"type": "string", "minLength": 1},
    "designRevision": {"type": "string", "minLength": 1},
    "panels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "separateGeometry": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "priorityFitZones": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredPoses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "researchTrial": {"type": "object"},
    "releaseBoundary": {"type": "string", "minLength": 1}
  }
}

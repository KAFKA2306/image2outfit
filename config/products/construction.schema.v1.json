{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/image2outfit/config/products/construction.schema.v1.json",
  "title": "image2outfit construction contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "profile"
  ],
  "properties": {
    "prototypeWeightRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pieceIds",
          "bodyTriangleZM",
          "excludedBoneNamePrefixes",
          "evidenceBoundary"
        ],
        "properties": {
          "pieceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bodyTriangleZM": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "excludedBoneNamePrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceBoundary": {
            "type": "string",
            "minLength": 1
          },
          "weightProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "pieceIds",
              "hipBone",
              "leftThighBone",
              "rightThighBone",
              "waistThighWeight",
              "hemThighWeight",
              "centerlineHalfWidthM",
              "fullSideWeightWidthM",
              "evidenceBoundary"
            ],
            "properties": {
              "method": {
                "const": "hip-anchored-lateral-thigh-fade-v1"
              },
              "pieceIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hipBone": {
                "type": "string",
                "minLength": 1
              },
              "leftThighBone": {
                "type": "string",
                "minLength": 1
              },
              "rightThighBone": {
                "type": "string",
                "minLength": 1
              },
              "waistThighWeight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hemThighWeight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "centerlineHalfWidthM": {
                "type": "number",
                "minimum": 0
              },
              "fullSideWeightWidthM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "evidenceBoundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^(fitted|panel-sewn|loose-layered)$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "designRevision": {
      "type": "string",
      "minLength": 1
    },
    "panels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredPatternComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "partId",
          "requiredPieceIds"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "partId": {
            "type": "string",
            "minLength": 1
          },
          "requiredPieceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "separateGeometry": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priorityFitZones": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredPoses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "researchTrial": {
      "type": "object"
    },
    "releaseBoundary": {
      "type": "string",
      "minLength": 1
    },
    "clothSimulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "components",
        "evidence",
        "reason"
      ],
      "properties": {
        "prototypePanelGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "prototypeFrameEnd": {
          "type": "integer",
          "minimum": 2,
          "maximum": 120
        },
        "prototypeWaistPinUpperFraction": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.5
        },
        "applicability": {
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED"
          ]
        },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "prototypeWaistPinBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "edgeId",
            "heightM",
            "toleranceM",
            "method"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "edgeId": {
              "type": "string",
              "minLength": 1
            },
            "heightM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "toleranceM": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.0001
            },
            "method": {
              "const": "open-boundary-at-declared-waist-height"
            }
          }
        },
        "prototypeRestShape": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pleated-overskirt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "sampleRowCount",
                "sectionBoundaryInsetM",
                "evidenceBoundary"
              ],
              "properties": {
                "method": {
                  "const": "canonical-row-circumference-rest-springs"
                },
                "sampleRowCount": {
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 128
                },
                "sectionBoundaryInsetM": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 0.001
                },
                "evidenceBoundary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "prototypeComponentBending": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stiffness",
              "evidencePath",
              "evidenceSha256",
              "evidenceBoundary"
            ],
            "properties": {
              "stiffness": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "evidencePath": {
                "type": "string",
                "minLength": 1
              },
              "evidenceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidenceBoundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "shapeKeyPostprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "applicability",
        "reason"
      ],
      "properties": {
        "provider": {
          "const": "maxwilso-smooth-shape-keys"
        },
        "applicability": {
          "enum": [
            "REQUIRED",
            "NOT_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
        },
        "invocation": {
          "enum": [
            "ACTIVE_KEY",
            "OPERATOR_MANAGED"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "object"
        },
        "cleanupOperator": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
        },
        "cleanupProperties": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "REQUIRED"
              }
            }
          },
          "then": {
            "required": [
              "module",
              "operator",
              "invocation",
              "targets",
              "properties"
            ]
          }
        }
      ]
    },
    "bodyProfileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "sourceEvidencePath",
        "sourceAvatar",
        "evidenceBoundary",
        "sha256",
        "sourceEvidenceSha256",
        "sourceAvatarSha256"
      ],
      "properties": {
        "status": {
          "const": "MEASURED_BODY_ONLY"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidencePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceAvatar": {
          "type": "string",
          "minLength": 1
        },
        "evidenceBoundary": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceAvatarSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "frontClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outerPieceId",
        "underPieceId",
        "diagonalEdgeId",
        "outerHemExtensionAcrossCenterM",
        "outerExclusiveVertexLayerOffsetM",
        "construction",
        "fastenerStatus",
        "evidenceBoundary"
      ],
      "properties": {
        "status": {
          "const": "PROTOTYPE_OVERLAP_UNFASTENED"
        },
        "outerPieceId": {
          "type": "string",
          "minLength": 1
        },
        "underPieceId": {
          "type": "string",
          "minLength": 1
        },
        "diagonalEdgeId": {
          "type": "string",
          "minLength": 1
        },
        "outerHemExtensionAcrossCenterM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outerExclusiveVertexLayerOffsetM": {
          "type": "number",
          "minimum": 0
        },
        "construction": {
          "type": "string",
          "minLength": 1
        },
        "fastenerStatus": {
          "const": "NOT_IMPLEMENTED"
        },
        "evidenceBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
